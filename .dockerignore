# Only application build inputs enter the Docker build context.
**
!pom.xml
!contacts-events/
!contacts-events/pom.xml
!contacts-events/src/
!contacts-events/src/main/
!contacts-events/src/main/**
!contacts-api/
!contacts-api/pom.xml
!contacts-api/src/
!contacts-api/src/main/
!contacts-api/src/main/**
!contacts-api/src/test/
!contacts-api/src/test/**
!contacts-reporter/
!contacts-reporter/pom.xml
!contacts-reporter/src/
!contacts-reporter/src/main/
!contacts-reporter/src/main/**
!contacts-reporter/src/test/
!contacts-reporter/src/test/**
!containers/
!containers/*.sh
!containers/maven-settings.xml
!identity/
!identity/realm/
!identity/realm/contacts-realm.json
**/.env
**/.env.*
**/*.jwt
**/*.pem
**/*.key
**/target/**
**/.git/**
