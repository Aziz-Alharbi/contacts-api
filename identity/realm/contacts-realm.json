{
  "realm": "contacts",
  "enabled": true,
  "displayName": "Contacts",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Application user / reporter access"
      },
      {
        "name": "admin",
        "description": "Application administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "contacts-api",
      "name": "Contacts API / local token demonstration",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "contacts-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "contacts-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "application-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "user-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "contacts-reporter",
      "name": "Contacts Reporter service account",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CONTACTS_REPORTER_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "contacts-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "contacts-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "application-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "contacts-api",
      "roles": [
        "user",
        "admin"
      ]
    },
    {
      "client": "contacts-reporter",
      "roles": [
        "user"
      ]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "email": "demo-user@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "realmRoles": [
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${CONTACTS_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-admin",
      "enabled": true,
      "email": "demo-admin@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "realmRoles": [
        "user",
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${CONTACTS_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-contacts-reporter",
      "enabled": true,
      "serviceAccountClientId": "contacts-reporter",
      "realmRoles": [
        "user"
      ]
    }
  ]
}
