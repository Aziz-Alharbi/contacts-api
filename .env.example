# Optional Compose overrides. No .env is required for docker compose up --build.
# Empty credential overrides use random values generated in the development-secrets volume.
# For host-based Java development, use the existing Java identity init-env command.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
CONTACTS_USER_PASSWORD=
CONTACTS_ADMIN_PASSWORD=
CONTACTS_REPORTER_SECRET=
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Reporter settings (the service secret above is shared with Keycloak import).
CONTACTS_REPORTER_CLIENT_ID=contacts-reporter
CONTACTS_API_URL=http://localhost:8080
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
CONTACTS_API_PORT=8080
CONTACTS_REPORTER_PORT=8082
KEYCLOAK_PORT=8081

# Local development broker. Export these too if running Maven outside Compose with custom values.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=contacts
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672

# Kafka applications run on the host; export custom values for Maven too.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONTACT_TOPIC=contacts.contact-created.v1
KAFKA_COUNTS_TOPIC=contacts.reporter.contact-counts.v1
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_REPORTER_APPLICATION_ID=contacts-reporter-v1
KAFKA_STATE_DIR=.kafka-state
KAFKA_PORT=9092
