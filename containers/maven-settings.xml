<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <!-- Public repositories only; never copy a developer's authenticated settings into a build. -->
  <profiles>
    <profile>
      <id>container-repositories</id>
      <repositories>
        <repository><id>central</id><url>https://repo.maven.apache.org/maven2</url><snapshots><enabled>false</enabled></snapshots></repository>
        <repository><id>gradle</id><url>https://repo.gradle.org/artifactory/libs-releases</url><snapshots><enabled>false</enabled></snapshots></repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository><id>central</id><url>https://repo.maven.apache.org/maven2</url><snapshots><enabled>false</enabled></snapshots></pluginRepository>
        <pluginRepository><id>gradle</id><url>https://repo.gradle.org/artifactory/libs-releases</url><snapshots><enabled>false</enabled></snapshots></pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>container-repositories</activeProfile></activeProfiles>
</settings>
